[telegram]
api_id = 12345
api_hash = hash
session = user_session

[groups]
target_group = https://t.me/123

source_groups =
    https://t.me/123
    https://t.me/123

[forwarding]
forward_batch_size = 50
concurrency = 1
rate_limit_delay = 1.4
floodwait_buffer = 5
persist_forwarded_uids_file = forwarded_uids.json
state_file = state.json

[deduplication]
enabled = true

[state]
checkpoint_dir = checkpoints
snapshot_interval_messages = 2000

[logging]
log_dir = logs
log_level = INFO
